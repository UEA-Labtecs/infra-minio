# ==============================================
# MinIO Configuration
# ==============================================
# Copie este arquivo para .env e ajuste os valores
# cp env.template .env

# ==============================================
# CREDENCIAIS
# ==============================================
# IMPORTANTE: Troque em produção!
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==============================================
# URLs PÚBLICAS
# ==============================================
# URL da API S3 (para presigned URLs)
MINIO_SERVER_URL=https://api-minio.labtecs.com.br

# URL do Console Web
MINIO_BROWSER_REDIRECT_URL=https://minio.labtecs.com.br

# ==============================================
# DOMÍNIO (OPCIONAL)
# ==============================================
# Se usar virtual-host-style requests
# MINIO_DOMAIN=minio.labtecs.com.br

# ==============================================
# REGIÃO (OPCIONAL)
# ==============================================
MINIO_REGION_NAME=us-east-1

# ==============================================
# NOTAS DE PRODUÇÃO
# ==============================================
# 1. Use credenciais fortes (min 8 caracteres)
# 2. Configure HTTPS no nginx
# 3. Configure CORS se necessário
# 4. Faça backups regulares
# 5. Monitore uso de disco

